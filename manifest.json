{
  "manifest_version": 3,
  "name": "МЫШЬ",
  "version": "2.4",
  "description": "Extension to mesh",
  "permissions": [
    "activeTab",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://school.mos.ru/*",
    "https://*.mos.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "МЫШЬ"
  },
  "content_scripts": [
    {
      "matches": ["https://school.mos.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://school.mos.ru/*"],
      "js": ["material_interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
